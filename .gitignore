# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
venv/
.venv/
env/

# --- Environment / secrets ---
.env
.env.local

# --- Data (large / not committed — see data/README.md for how to regenerate) ---
data/raw/real/*
data/raw/ai/*
data/processed/train/*
data/processed/val/*
data/processed/test/*
!data/raw/real/.gitkeep
!data/raw/ai/.gitkeep
!data/processed/train/.gitkeep
!data/processed/val/.gitkeep
!data/processed/test/.gitkeep

# --- Model weights (large binaries — track via release/HF Hub, not git) ---
# NOTE: this only matches files directly under models/, NOT models/production/
# — that directory holds the deployed model for HF Spaces and IS meant to be
# committed (via git-lfs, see .gitattributes) despite this rule. See
# DEPLOYMENT.md for the full HF Spaces deployment flow.
models/*.pt
models/*.pth
models/*.onnx
!models/.gitkeep

# --- Logs / experiment outputs ---
runs/
logs/
*.log
wandb/

# --- OS / editor cruft ---
.DS_Store
.idea/
.vscode/

# --- Streamlit ---
.streamlit/secrets.toml
.coverage
htmlcov/
